{
  "name": "wolt-mcp-server",
  "version": "0.1.0",
  "description": "Unofficial MCP server for Wolt: browse venues and menus from an AI agent. Not affiliated with Wolt.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "wolt-mcp-server": "dist/cli/index.js",
    "wolt-mcp": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "biome check .",
    "fix": "biome check --write .",
    "doctor": "npm run build && node dist/cli/index.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
